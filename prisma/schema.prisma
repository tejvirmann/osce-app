generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OsceScenario {
  id                       String   @id @default(cuid())
  title                    String
  spec                     Json
  status                   String   @default("draft") // draft | published
  twilioNumber             String?
  dograhWorkflowIdTraining String?
  dograhWorkflowIdExam     String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
